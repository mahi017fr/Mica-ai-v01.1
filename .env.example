# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Key for Groq Llama-powered AI responses
GROQ_API_KEY=

# Circle Modular Wallets (passkey-backed smart accounts) — Legacy/Phase 1.
# Get these from the Circle Developer Console -> Modular Wallets configurator.
# VITE_CLIENT_KEY: the client key used to authenticate SDK requests.
# VITE_CLIENT_URL: the Circle Modular Wallets RPC base URL (DO NOT append the
# chain path here — the SDK appends `/arcTestnet` internally).
VITE_CLIENT_KEY=""
VITE_CLIENT_URL="https://modular-sdk.circle.com/v1/rpc/w3s/buidl"

# Circle Developer-Controlled Wallets — Phase 2 (server-side).
# NEVER prefix these with VITE_ — they must NEVER reach the browser.
# CIRCLE_API_KEY: from Circle Console -> Keys -> API Keys -> Create Standard Key.
# CIRCLE_ENTITY_SECRET: generated via SDK generateEntitySecret(), then registered
#   with Circle via registerEntitySecretCiphertext(). Recovery file downloaded once.
# CIRCLE_WALLET_SET_ID: created via SDK createWalletSet() or Circle Console.
CIRCLE_API_KEY=""
CIRCLE_ENTITY_SECRET=""
CIRCLE_WALLET_SET_ID=""

# Cloudinary credentials for file uploads (audio, images, attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MICA secret-at-rest encryption ─────────────────────────────────────────
# NEVER prefix this with VITE_ — it must never reach the browser bundle.
#
# Encrypts per-user MCP connection credentials (bearer tokens / API keys) with
# AES-256-GCM before they are written to Firestore. Only the MICA backend reads
# it, and only to decrypt a secret for the server-side MCP handshake.
#
# Format: exactly 32 bytes, supplied as 64 hex characters (64 base64 characters
# are also accepted). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: this key is the only thing protecting stored MCP secrets. Rotating it
# makes every previously saved MCP connection undecryptable — users must re-enter
# their tokens. Back it up somewhere safe; losing it loses all stored secrets.
MICA_SECRET_ENCRYPTION_KEY=""


# ---------------------------------------------------------------------------
# Firebase Admin (server-side) - REQUIRED for every authenticated MCP route.
# Verifies the browser's Firebase ID token and reads/writes Firestore.
#
# NEVER prefix these with VITE_ - they must never reach the browser bundle.
# FIREBASE_PRIVATE_KEY: the service account PEM on a single line; both the
#   single-line form and a "\n"-escaped form are accepted.
#   (or) set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
#
# DEPLOYMENT: this file is gitignored, so Vercel never sees it. Every server
# variable below (GROQ_API_KEY, MICA_SECRET_ENCRYPTION_KEY, FIREBASE_*) must
# also be added in Vercel -> Project -> Settings -> Environment Variables with
# the "Production" scope enabled, then redeployed. A missing variable is the
# usual reason the MCP agent works on localhost and fails after deploy.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""
